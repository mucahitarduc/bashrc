# Functions to aid git workflow
function ga(){
    git-add $1
}

function gc(){
    git commit -m "$*"
}

function revert(){
    git reset --hard $1
}

# Simplify apt-get search and install
function show ()
{
    apt-cache search $1
}

function install ()
{
    sudo apt-get install "$@"
}

# Useful unarchiver!
function extract () {
        if [ -f $1 ] ; then
                case $1 in
                        *.tar.bz2)        tar xjf $1                ;;
                        *.tar.gz)        tar xzf $1                ;;
                        *.bz2)                bunzip2 $1                ;;
                        *.rar)                rar x $1                ;;
                        *.gz)                gunzip $1                ;;
                        *.tar)                tar xf $1                ;;
                        *.tbz2)                tar xjf $1                ;;
                        *.tgz)                tar xzf $1                ;;
                        *.zip)                unzip $1                ;;
                        *.Z)                uncompress $1        ;;
                        *)                        echo "'$1' cannot be extracted via extract()" ;;
                esac
        else
                echo "'$1' is not a valid file"
        fi
}

function psg() {
        if [ ! -z $1 ] ; then
                echo "Grepping for processes matching $1..."
                ps aux | grep $1 
        else
                echo "!! Need name to grep for"
        fi
}

# Find, needs 'sudo apt-get install silversearcher-ag'
# Ignores sandbox environments, in this case, folder
# starting with chroot/
function f()
{
    ag --ignore chroot "$@"
}

# Because I am a lazy bum, and this is
# surpisingly helpful..
function up()
{
    local dir=$''
    for i in `seq 1 $1`;
    do
        dir=$dir$'../'
    done;
    cd $dir
}

# Required for the prompt to show git status
function parse_git_dirty {
[[ $(git status 2> /dev/null | tail -n1) != "nothing to commit (working directory clean)" ]] && echo "*"
}
function parse_git_branch {
git branch --no-color 2> /dev/null | sed -e '/^[^*]/d' -e "s/* \(.*\)/[\1$(parse_git_dirty)]/"
}

waitfor() {
  local path=$1
  echo "Waiting for $path ..."
  while [ ! -e "$path" ]; do
    sleep 1
  done
  shift
  "$@"
}


kill_match () {
    auto_yes=false

    # Check for -y flag
    echo $1
    if [ $1 = "-y" ]; then
        auto_yes=true
        shift   # remove -y from args
        echo $1
    fi

    if [ -z "$1" ]; then
        echo "Usage: kill_match [-y] <text>"
        return 1
    fi

    pids=$(pgrep -f "$1")

    if [ -z "$pids" ]; then
        echo "No processes found matching: $1"
        return 0
    fi

    for pid in $pids; do
        line=$(ps -p "$pid" -o pid,ppid,user,cmd --no-headers)
	if ! [ -z "$line" ]; then
            echo "Found: $line"

            if [ "$auto_yes" = true ]; then
                ans="y"
            else
                read -p "Kill this process? (y/n) " ans;
            fi

            if [ "$ans" = "y" ]; then
                kill -9 "$pid"
                echo "Killed PID $pid"
            else
                echo "Skipped PID $pid"
            fi
        fi
    done
}

dedup_history() {
    local hist="${HISTFILE:-$HOME/.bash_history}"
    local tmp

    tmp=$(mktemp "${hist}.XXXXXX") || return 1

    awk '
    {
        line[NR] = $0
        last[$0] = NR
    }
    END {
        for (i = 1; i <= NR; i++)
            if (last[line[i]] == i)
                print line[i]
    }
    ' "$hist" > "$tmp" && mv "$tmp" "$hist"
}
