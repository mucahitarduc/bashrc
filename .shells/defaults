############## HISTORY OPTIONS ################

function clean_dups {
    cat "$HISTFILE" >> "$HISTFILE.old"
    temp_hist=$(mktemp)
    tac "$HISTFILE" | awk '!x[$0]++' > $temp_hist  &&
                    tac $temp_hist > "$HISTFILE"
    rm $temp_hist
}

function load_old_history {
    if [ -f "$HISTFILE.old" ]; then
        cat "$HISTFILE.old" >> "$HISTFILE"
    fi
}
# Don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options

# Append to the history file, don't overwrite it
shopt -s histappend
export HISTCONTROL=ignoreboth:erasedups
clean_dups
# Save and reload history after each command finishes
export PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"
if [ "${CONTAINER_ID}" ]; then
PS1=$red'<${CONTAINER_ID}>'$(echo "$PS1" | sed 's/\\$ $//')$orange'$(parse_git_branch)'$white'$ '
else
PS1=$(echo "$PS1" | sed 's/\\$ $//')$orange'$(parse_git_branch)'$white'$ '
fi
# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000000
HISTFILESIZE=2000000



############## GENERAL UI ################
force_color_prompt=yes



